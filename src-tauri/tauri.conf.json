{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "键盘小勇士",
  "version": "1.0.0",
  "identifier": "com.typing.kids",
  "build": {
    "frontendDist": "../typing-kids/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../typing-kids && npm run dev",
    "beforeBuildCommand": "cd ../typing-kids && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "🌟 键盘小勇士 - 打字练习",
        "width": 960,
        "height": 800,
        "resizable": true,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
